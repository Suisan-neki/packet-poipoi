# Copy to scripts/packet-poipoi.env for local use or to the Pi deploy directory.
# Keep these addresses on a managed, isolated Ethernet LAN.

PI_A_HOST=pi@192.168.50.10
PI_B_HOST=pi@192.168.50.20
PI_A_IP=192.168.50.10
PI_B_IP=192.168.50.20
PI_IFACE=eth0

PACKET_POIPOI_REMOTE_DIR=~/packet-poipoi-bin
PACKET_POIPOI_STREAM_ADDR=192.168.50.20:9010
PACKET_POIPOI_EVENT_ADDR=192.168.50.20:9001
PACKET_POIPOI_EBPF_ADDR=127.0.0.1:9000
PACKET_POIPOI_XDP_CONTROL=127.0.0.1:9020
PACKET_POIPOI_TRAFFIC_CONTROL=192.168.50.10:9030
PACKET_POIPOI_HTTP_TARGET=192.168.50.20
PACKET_POIPOI_HTTP_PORT=8080
PACKET_POIPOI_ATTACK_PORT=4000
PACKET_POIPOI_PPS_STEPS=500,2000,5000,10000,20000,50000
PACKET_POIPOI_DURATION_SECS=10
PACKET_POIPOI_REPETITIONS=3
PACKET_POIPOI_XDP_MODE=auto
